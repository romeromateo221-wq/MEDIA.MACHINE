<style>
:root {
  --black: #101014;
  --white: #ffffff;
  --light: #f6f6f8;
  --text: #17171e;
  --muted: #777783;
  --purple: #7048ff;
  --pink: #fb527c;
  --cyan: #27bedb;
  --border: #e8e8ed;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: "DM Sans", sans-serif;
  background: var(--white);
  color: var(--text);
  overflow-x: hidden;
}

a {
  text-decoration: none;
  color: inherit;
}

button {
  font-family: inherit;
  cursor: pointer;
}

.container {
  max-width: 1240px;
  margin: auto;
  padding: 0 24px;
}

/* NAVBAR */

.navbar {
  height: 82px;
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255,255,255,.94);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border);
}

.nav-inner {
  max-width: 1240px;
  height: 100%;
  margin: auto;
  padding: 0 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.logo {
  font-family: Outfit, sans-serif;
  font-size: 23px;
  font-weight: 900;
  letter-spacing: -1.2px;
  white-space: nowrap;
}

.logo span {
  color: var(--purple);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 30px;
}

.nav-links a {
  font-size: 14px;
  font-weight: 600;
  transition: color .25s;
}

.nav-links a:hover {
  color: var(--purple);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 15px 25px;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 700;
  transition: transform .3s, box-shadow .3s;
}

.btn:hover {
  transform: translateY(-3px);
}

.btn-dark {
  background: var(--black);
  color: white;
}

.btn-gradient {
  background: linear-gradient(110deg,var(--purple),var(--pink));
  color: white;
  box-shadow: 0 12px 30px #7048ff35;
}

.btn-outline {
  border: 1px solid #c9c9d0;
  color: var(--text);
}

.menu-toggle {
  display: none;
  background: none;
  border: none;
  font-size: 28px;
}

/* HERO */

.hero {
  position: relative;
  overflow: hidden;
  padding: 115px 0 110px;
  background:
    radial-gradient(circle at 90% 20%,#7048ff22,transparent 35%),
    radial-gradient(circle at 5% 85%,#fb527c15,transparent 35%),
    #fff;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.1fr .9fr;
  align-items: center;
  gap: 65px;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  font-size: 12px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: var(--purple);
}

.eyebrow::before {
  content: "";
  width: 20px;
  height: 2px;
  background: var(--purple);
}

.hero h1 {
  font-family: Outfit, sans-serif;
  font-size: clamp(52px,6.5vw,92px);
  font-weight: 900;
  line-height: 1.02;
  letter-spacing: -4px;
  margin: 24px 0;
}

.gradient-text {
  background: linear-gradient(100deg,var(--purple),var(--pink));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero p {
  max-width: 570px;
  font-size: 18px;
  line-height: 1.8;
  color: var(--muted);
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 35px;
}

.hero-art {
  min-height: 460px;
  position: relative;
  border-radius: 30px;
  background: #15131e;
  overflow: hidden;
  box-shadow: 0 30px 65px #15131e25;
}

.hero-art::before {
  content: "";
  position: absolute;
  inset: -30%;
  background:
    conic-gradient(
      from 40deg,
      #7048ff,
      #fb527c,
      #17131e,
      #28bcd9,
      #7048ff
    );
  filter: blur(45px);
  animation: rotateGlow 15s linear infinite;
}

.hero-art::after {
  content: "";
  position: absolute;
  inset: 16%;
  border: 1px solid #ffffff35;
  border-radius: 40px;
  transform: rotate(-18deg);
}

.hero-art-content {
  position: absolute;
  z-index: 2;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 35px;
  color: white;
}

.hero-art-content strong {
  font-family: Outfit, sans-serif;
  font-size: clamp(36px,4vw,65px);
  font-weight: 900;
  letter-spacing: -3px;
}

.hero-art-content small {
  margin-top: 12px;
  font-size: 12px;
  letter-spacing: 5px;
  text-transform: uppercase;
}

@keyframes rotateGlow {
  to {transform: rotate(360deg)}
}

/* SECTIONS */

.section {
  padding: 105px 0;
}

.section-light {
  background: var(--light);
}

.section-dark {
  background: var(--black);
  color: white;
}

.section-heading {
  max-width: 780px;
  margin-bottom: 48px;
}

.section-heading h2 {
  font-family: Outfit, sans-serif;
  font-size: clamp(36px,4vw,58px);
  line-height: 1.12;
  letter-spacing: -2px;
  margin: 18px 0;
}

.section-heading p {
  font-size: 16px;
  line-height: 1.8;
  color: var(--muted);
}

.section-dark .section-heading p {
  color: #aaaaaf;
}

/* SERVICES */

.services-grid {
  display: grid;
  grid-template-columns: repeat(2,1fr);
  gap: 20px;
}

.service-card {
  padding: 38px;
  border: 1px solid var(--border);
  border-radius: 20px;
  background: white;
  transition: transform .3s,box-shadow .3s;
}

.service-card:hover {
  transform: translateY(-7px);
  box-shadow: 0 25px 55px #00000010;
}

.service-number {
  color: var(--purple);
  font-size: 13px;
  font-weight: 800;
}

.service-card h3 {
  font-family: Outfit,sans-serif;
  font-size: 27px;
  margin: 20px 0 12px;
}

.service-card p {
  color: var(--muted);
  line-height: 1.8;
}

.service-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-top: 25px;
}

.service-tags span {
  font-size: 12px;
  border-radius: 30px;
  padding: 9px 12px;
  background: #f3f2f8;
  color: #555462;
}

/* PROJECT GALLERY */

.gallery-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 30px;
}

.gallery-count {
  color: #aaaab5;
  font-size: 14px;
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 20px;
}

.gallery-item {
  position: relative;
  border: 1px solid #ffffff18;
  border-radius: 16px;
  background: #24242b;
  overflow: hidden;
  cursor: pointer;
  min-height: 260px;
  transition: transform .35s;
}

.gallery-item:hover {
  transform: translateY(-5px);
}

.gallery-item img {
  display: block;
  width: 100%;
  height: 320px;
  object-fit: cover;
  transition: transform .5s;
}

.gallery-item:hover img {
  transform: scale(1.06);
}

.gallery-label {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30px 18px 18px;
  color: white;
  background: linear-gradient(transparent,#000b);
  font-size: 13px;
  font-weight: 700;
}

.gallery-error {
  min-height: 280px;
  padding: 25px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 12px;
  color: #c5c5cc;
}

.gallery-error strong {
  color: white;
  font-size: 15px;
}

.gallery-error small {
  font-size: 11px;
  overflow-wrap: anywhere;
}

.gallery-actions {
  text-align: center;
  margin-top: 40px;
}

/* PROCESS */

.process-grid {
  display: grid;
  grid-template-columns: repeat(5,1fr);
  gap: 16px;
}

.process-card {
  border-top: 2px solid var(--purple);
  padding: 26px 16px;
}

.process-card strong {
  font-family: Outfit,sans-serif;
  color: var(--purple);
  font-size: 34px;
}

.process-card h3 {
  margin: 20px 0 10px;
  font-size: 18px;
}

.process-card p {
  color: var(--muted);
  line-height: 1.7;
  font-size: 13px;
}

/* ABOUT */

.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
}

.about-card {
  border-radius: 20px;
  padding: 40px;
  background: var(--light);
}

.about-card h3 {
  font-size: 26px;
  margin-bottom: 18px;
}

.about-card p {
  color: var(--muted);
  line-height: 1.85;
}

/* CONTACT */

.contact-panel {
  border-radius: 28px;
  background:
    radial-gradient(circle at 90% 20%,#fb527c65,transparent 35%),
    linear-gradient(110deg,#5330de,#191426);
  padding: 80px;
  color: white;
}

.contact-panel h2 {
  font-family: Outfit,sans-serif;
  font-size: clamp(36px,5vw,64px);
  max-width: 730px;
  letter-spacing: -2px;
  line-height: 1.1;
}

.contact-panel p {
  margin: 25px 0 35px;
  color: #ddd5fa;
  line-height: 1.8;
}

.contact-panel .btn {
  background: white;
  color: var(--black);
}

/* FOOTER */

.footer {
  background: #101014;
  color: white;
  padding: 70px 0 30px;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr;
  gap: 40px;
}

.footer p {
  color: #a5a5af;
  font-size: 14px;
  line-height: 1.9;
  margin-top: 15px;
}

.footer h4 {
  margin-bottom: 18px;
}

.footer a {
  display: block;
  margin-bottom: 13px;
  font-size: 14px;
  color: #bcbcc4;
}

.footer a:hover {
  color: white;
}

.footer-bottom {
  border-top: 1px solid #ffffff20;
  margin-top: 45px;
  padding-top: 25px;
  color: #888892;
  font-size: 12px;
}

/* LIGHTBOX */

.lightbox {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(8,8,12,.96);
  align-items: center;
  justify-content: center;
  padding: 50px;
}

.lightbox.active {
  display: flex;
}

.lightbox img {
  max-width: 95%;
  max-height: 88vh;
  object-fit: contain;
}

.lightbox-close {
  position: absolute;
  right: 25px;
  top: 15px;
  background: transparent;
  border: 0;
  color: white;
  font-size: 45px;
}

/* ANIMATIONS */

.reveal {
  opacity: 0;
  transform: translateY(25px);
  transition: opacity .7s,transform .7s;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

/* RESPONSIVE */

@media(max-width:950px) {
  .hero-grid {
    grid-template-columns: 1fr;
  }

  .hero-art {
    min-height: 330px;
  }

  .gallery-grid {
    grid-template-columns: repeat(2,1fr);
  }

  .process-grid {
    grid-template-columns: repeat(3,1fr);
  }

  .nav-links {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 82px;
    background: white;
    padding: 25px;
    flex-direction: column;
    border-bottom: 1px solid var(--border);
  }

  .nav-links.open {
    display: flex;
  }

  .menu-toggle {
    display: block;
  }
}

@media(max-width:650px) {
  .hero {
    padding: 75px 0;
  }

  .hero h1 {
    letter-spacing: -2px;
  }

  .section {
    padding: 70px 0;
  }

  .services-grid,
  .gallery-grid,
  .about-grid,
  .footer-grid {
    grid-template-columns: 1fr;
  }

  .process-grid {
    grid-template-columns: repeat(2,1fr);
  }

  .gallery-item img {
    height: auto;
    max-height: 450px;
    object-fit: contain;
  }

  .contact-panel {
    padding: 45px 25px;
  }

  .lightbox {
    padding: 15px;
  }
}

@media(prefers-reduced-motion:reduce) {
  *,
  *::before,
  *::after {
    animation-duration: .01ms !important;
    transition-duration: .01ms !important;
  }

  .reveal {
    opacity: 1;
    transform: none;
  }
}
</style>
</head>

